Project timetracker {
  database_type: 'PostgreSQL'
}

table users {
  id int [pk]
  tg_id varchar(64) [unique]
  role varchar
  department_id int
  status varchar
  created_at timestamp
}

table projects {
  id int [pk]
  name varchar
  code varchar [unique]
  is_active boolean
}

table shifts {
  id int [pk]
  user_id int [ref: > users.id]
  started_at timestamp
  paused_at timestamp
  resumed_at timestamp
  finished_at timestamp
  status varchar
  project_id int [ref: > projects.id]
  note varchar
}

table breaks {
  id int [pk]
  shift_id int [ref: > shifts.id]
  started_at timestamp
  finished_at timestamp
  type varchar
}

table requests {
  id int [pk]
  user_id int [ref: > users.id]
  type varchar
  status varchar
  from_date timestamp
  to_date timestamp
  days int
  approver_id int [ref: > users.id]
  comment varchar
}

table audit_log {
  id int [pk]
  user_id int [ref: > users.id]
  action varchar
  entity varchar
  entity_id int
  payload jsonb
  created_at timestamp
}

table idempotency_keys {
  id int [pk]
  user_id int [ref: > users.id]
  action varchar
  key varchar
  created_at timestamp
}